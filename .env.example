# Copy this file to `.env` and adjust values for your local environment.
# `.env` is git-ignored and must never be committed.

# --- PostgreSQL ---
POSTGRES_USER=quizzy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=quizzy
POSTGRES_PORT=5432

# --- JWT ---
# A long random secret used to sign access tokens (keep it private).
Jwt__SigningKey=replace-with-a-long-random-secret-at-least-32-chars

# --- Initial admin account (optional) ---
# When both are set, an administrator account is created on first run.
Seed__AdminEmail=admin@quizzy.local
Seed__AdminPassword=change-me
