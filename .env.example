# Copy this file to `.env` and adjust values for your local environment.
# `.env` is git-ignored and must never be committed.

# --- PostgreSQL ---
POSTGRES_USER=quizzy
POSTGRES_PASSWORD=quizzy
POSTGRES_DB=quizzy
POSTGRES_PORT=5432

# --- RabbitMQ ---
RABBITMQ_USER=quizzy
RABBITMQ_PASSWORD=quizzy
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
# Point the API at the broker when running it on the host. In the full Docker
# stack the API reaches the broker at the `rabbitmq` service name automatically.
# Leave unset to run the message bus in-process.
RabbitMq__Host=localhost
RabbitMq__Username=quizzy
RabbitMq__Password=quizzy

# --- Published ports (Docker stack) ---
# The web client is the main entry point; the API also exposes Swagger at /swagger.
WEB_PORT=8080
API_PORT=8081

# --- JWT ---
# A long random secret used to sign access tokens (keep it private).
Jwt__SigningKey=replace-with-a-long-random-secret-at-least-32-chars

# --- Initial admin account (optional) ---
# When both are set, an administrator account is created on first run.
Seed__AdminEmail=admin@quizzy.local
Seed__AdminPassword=change-me
